{
  "name": "hanboro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "esbuild@0.25.12": true,
    "fsevents": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/prepare-dist.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "export:shopify-csv": "node scripts/generate-shopify-products-csv.mjs",
    "export:shopify-theme": "node scripts/package-shopify-theme.mjs",
    "sync:shopify-ids": "node scripts/generate-shopify-id-map.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2"
  }
}
