# Shopify Headless Storefront Credentials
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

VITE_SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
VITE_STOREFRONT_PUBLIC_URL=https://www.hanborowatches.in
# Shopify Customer Account API (OAuth & Customer Identity)
VITE_SHOPIFY_CUSTOMER_CLIENT_ID=your_customer_client_id
VITE_SHOPIFY_SHOP_ID=your_shop_id

# OAuth and Customer Account GraphQL endpoints are discovered automatically
# from the configured storefront domain at runtime.
# Optional overrides for deployments that pin Customer Account endpoints.
# The redirect URI must also be registered in Shopify Customer Account settings.
# VITE_SHOPIFY_CUSTOMER_REDIRECT_URI=https://www.hanborowatches.in/
# VITE_SHOPIFY_AUTH_ENDPOINT=https://shopify.com/authentication/your_shop_id/oauth/authorize
# VITE_SHOPIFY_TOKEN_ENDPOINT=https://shopify.com/authentication/your_shop_id/oauth/token
# VITE_SHOPIFY_LOGOUT_ENDPOINT=https://shopify.com/authentication/your_shop_id/logout
# VITE_SHOPIFY_CUSTOMER_GRAPHQL_ENDPOINT=https://shopify.com/your_shop_id/account/customer/api/2026-07/graphql

# Never expose an Admin API token as a VITE_ variable. Product edits, customers,
# orders, and draft orders remain merchant-side responsibilities in Shopify Admin.

# fastrr Checkout is loaded from Shiprocket's official Shopify runtime and is
# identified by the Shopify shop domain in index.html. Do not put fastrr or
# Shopify Admin secrets in VITE_ variables.

# Optional Shiprocket order-tracking proxy (server-side only).
SHIPROCKET_EMAIL=your_shiprocket_account_email
SHIPROCKET_PASSWORD=your_shiprocket_account_password
